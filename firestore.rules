rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // User Role Helpers
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isSignedIn() 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
             && getUserData().get('role', '') == role;
    }
    function isAdmin() { return hasRole('admin'); }
    function isDoctor() { return hasRole('doctor') || isAdmin(); }
    function isPharmacist() { return hasRole('pharmacist') || isAdmin(); }

    // Validation Helpers
    function isValidUser(data) {
      return data.email is string && data.role in ['doctor', 'pharmacist', 'admin']
             && data.keys().hasAll(['email', 'role']);
    }

    function isValidPatient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Patients Collection
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create, update: if isDoctor();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create, update: if isDoctor();
    }

    // Consultations
    match /consultations/{consultationId} {
      allow read: if isSignedIn();
      allow create, update: if isDoctor();
    }

    // Prescriptions
    match /prescriptions/{prescriptionId} {
      allow read: if isSignedIn();
      allow create, update: if isDoctor() || isPharmacist();
    }

    // Medicines
    match /medicines/{medicineId} {
      allow read: if isSignedIn();
      allow write: if isPharmacist() || isAdmin();
    }

    // Batches
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isPharmacist() || isAdmin();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isPharmacist() || isAdmin() || isDoctor();
    }

    // Reminders
    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isDoctor() || isPharmacist();
    }
  }
}
